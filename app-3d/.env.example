# Copie este arquivo para ".env" e preencha.
# Sem token, o app abre em MODO DEMONSTRAÇÃO (sensores simulados).

# Auth Token do dispositivo (Blynk.Console → Devices → seu dispositivo → Device Info)
BLYNK_TOKEN=cole_aqui_o_token_do_seu_dispositivo

# Servidor da sua região no Blynk (aparece no Blynk.Console, canto inferior do perfil).
# Exemplos: blynk.cloud, ny3.blynk.cloud, fra1.blynk.cloud, sgp1.blynk.cloud
BLYNK_SERVER=blynk.cloud

# Porta local do painel
PORT=3000

# Intervalo de leitura do Blynk em ms (mínimo 800). O servidor só consulta
# enquanto houver alguém com a página aberta, para poupar a cota gratuita.
POLL_INTERVAL_MS=1200

# Force o modo demonstração mesmo com token (true/false)
DEMO=false

# Sensores opcionais que estão no protoboard (separados por vírgula): ldr, garagem (HC-SR04).
# Vazio = os dois desligados (montagem atual). Ex.: SENSORES=ldr,garagem
SENSORES=

# Senha do painel (Basic Auth). Com ela definida, páginas, /api e o stream pedem login.
# Deixe vazia em desenvolvimento. Usuário padrão: casa
PAINEL_SENHA=
PAINEL_USUARIO=casa
