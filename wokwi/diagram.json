{
  "version": 1,
  "author": "Mini Casa Inteligente - FEPI",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -96, "left": -216, "attrs": { "temperature": "24", "humidity": "55" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": -150, "left": -40, "rotate": 0, "attrs": { "lux": "1000" } },
    { "type": "wokwi-hc-sr04", "id": "sonar1", "top": -160, "left": 180, "attrs": { "distance": "200" } },
    { "type": "wokwi-servo", "id": "servo1", "top": 60, "left": 250, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 190, "left": -170, "rotate": 0, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_luz", "top": 140, "left": -250, "attrs": { "color": "yellow", "label": "LUZ" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 260, "left": -170, "rotate": 0, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_porta", "top": 210, "left": -250, "attrs": { "color": "green", "label": "PORTA" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 230, "left": 230, "attrs": { "volume": "0.2" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3.1", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:4", "green", [] ],

    [ "ldr1:VCC", "esp:3V3.2", "red", [] ],
    [ "ldr1:GND", "esp:GND.1", "black", [] ],
    [ "ldr1:AO", "esp:1", "orange", [] ],

    [ "sonar1:VCC", "esp:5V", "red", [] ],
    [ "sonar1:GND", "esp:GND.2", "black", [] ],
    [ "sonar1:TRIG", "esp:5", "blue", [] ],
    [ "sonar1:ECHO", "esp:6", "violet", [] ],

    [ "servo1:V+", "esp:5V", "red", [] ],
    [ "servo1:GND", "esp:GND.3", "black", [] ],
    [ "servo1:PWM", "esp:7", "orange", [] ],

    [ "esp:15", "r1:1", "yellow", [] ],
    [ "r1:2", "led_luz:A", "yellow", [] ],
    [ "led_luz:C", "esp:GND.4", "black", [] ],

    [ "esp:16", "r2:1", "green", [] ],
    [ "r2:2", "led_porta:A", "green", [] ],
    [ "led_porta:C", "esp:GND.4", "black", [] ],

    [ "bz1:2", "esp:17", "magenta", [] ],
    [ "bz1:1", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
